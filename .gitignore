# See http://help.github.com/ignore-files/ for more about ignoring files.

# Node / Angular
/tmp
/out-tsc
/bazel-out
/node_modules
.npm-cache
.angular/
.pnpm-store/

# Python
.venv/
.uv-cache/
.pre-commit-cache/
venv/
env/
.env
.venv
docker/reranker/*
!docker/reranker/.gitkeep
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg-info

# Profiling
chrome-profiler-events*.json
speed-measure-plugin*.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Misc (build / logs)
/data/
/.sass-cache
/connect.lock
/coverage
/logs/
/frontend/playwright-report/
/frontend/test-results/
/frontend/blob-report/
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System
.DS_Store
Thumbs.db

# Local TEI embedding model files (large)
docker/embedding/

# Third-party Elasticsearch plugin binary; keep out of Git and document the
# download/install source in docker/elasticsearch/Dockerfile or README.
docker/elasticsearch/plugins/*
!docker/elasticsearch/plugins/.gitkeep
