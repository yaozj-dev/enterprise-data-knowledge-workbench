LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# Application settings
APP_JWT_SECRET=replace_with_a_random_string_at_least_32_characters
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace_with_a_random_admin_password
# Downloaded local instances can create regular users from the login page.
# Set false before exposing a shared deployment without an invitation or SSO layer.
APP_ALLOW_SELF_REGISTRATION=true
APP_DB_PATH=data/workbench.db
APP_LOG_JSON=false

# Agent orchestration switch: supervisor (default) or legacy (rollback path).
AGENT_ORCHESTRATOR_MODE=supervisor

# Least-privilege data warehouse account for the NL2SQL Agent
MYSQL_ROOT_PASSWORD=replace_with_a_random_mysql_root_password
DB_META_USER=workbench_meta
DB_META_PASSWORD=replace_with_a_random_meta_password
MYSQL_AGENT_READONLY_USER=agent_readonly
MYSQL_AGENT_READONLY_PASSWORD=replace_with_a_random_readonly_password
DB_DW_USER=agent_readonly
DB_DW_PASSWORD=replace_with_a_random_readonly_password

# Read-only analytics guardrails
SQL_QUERY_TIMEOUT_SECONDS=10
SQL_MAX_RESULT_ROWS=200
SQL_ALLOWED_TABLES=fact_order,dim_region,dim_customer,dim_product,dim_date
# Number of column examples shown to the table-filter LLM; SQL generation keeps full examples.
FILTER_TABLE_MAX_EXAMPLES=3

# Agent quality loop: explicit routes stay fast, ambiguous business questions use structured routing.
AGENT_ROUTER_POLICY_VERSION=hybrid-router-v1
AGENT_ROUTER_CONFIDENCE_THRESHOLD=0.72
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_MAX_CONTEXT_CHARACTERS=6000
QUALITY_TRACE_RETENTION_DAYS=90

# Optional Agent runtime state. Leave empty to use the fail-open in-process store.
REDIS_URL=
REDIS_TTL_SECONDS=3600
REDIS_MAX_EVENTS=200
REDIS_TIMEOUT_SECONDS=1.5
REDIS_FAILURE_COOLDOWN_SECONDS=30

# Optional BGE reranker endpoint. RRF remains the explicit fallback when empty.
# For the ranking Compose profile use: http://reranker:80/rerank
RERANKER_URL=
# CPU BGE reranking can take longer than embedding; each bounded batch has its
# own timeout, after which retrieval falls back to RRF.
RERANKER_TIMEOUT_SECONDS=30
RERANKER_FAILURE_COOLDOWN_SECONDS=60

# Supervisor structured planning and bounded Action/Observation loop.
# hybrid plans composite requests with DeepSeek and falls back to the
# server-owned deterministic plan after one repair attempt.
SUPERVISOR_PLANNER_MODE=hybrid
SUPERVISOR_PLANNER_INTENTS=composite
SUPERVISOR_PLANNER_TIMEOUT_SECONDS=4
AGENT_REACT_MODE=bounded

# Internal MCP service token. Keep empty to disable remote MCP calls.
MCP_SERVICE_TOKEN=
# Remote MCP endpoint used by the full Compose profile. Keep the token empty
# for direct host development so the gateway uses its local adapters instead.
MCP_TOOLS_URL=http://mcp:8000/mcp
MCP_TIMEOUT_SECONDS=8
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,backend:*,enterprise-data-backend:*,mcp:*

# Optional OpenTelemetry spans. No exporter is enabled unless explicitly requested.
REPORT_GENERATION_TIMEOUT_SECONDS=10
VERIFIER_LLM_TIMEOUT_SECONDS=2.5
VERIFIER_CONFIDENCE_THRESHOLD=0.75
REPORT_REPAIR_TIMEOUT_SECONDS=6
COMPOSITE_DATA_TIMEOUT_MS=45000
# Single data questions include several metadata/LLM stages; keep this
# independently configurable instead of silently timing out at 20 seconds.
DATA_AGENT_TIMEOUT_MS=45000
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-data-knowledge-workbench
OTEL_CONSOLE_EXPORT=false
# Optional OTLP/HTTP exporter. Leave empty for local no-op tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
